def indirim_hesapla(indirimsiz_tutar,indirim_yuzdesi):
    indirim_tutari = indirimsiz_tutar * indirim_yuzdesi / 100
    son_fiyat = indirimsiz_tutar - indirim_tutari
    print(f"Ürünün indirim tutari: {indirim_tutari}")
    print(f"Ürünün son fiyati: {son_fiyat}")
indirimsiz_tutar = int(input("Ürünün indirimsiz fiyati: "))
indirim_yuzdesi = int(input("Ürünün indirim yüzdesi: "))
while indirim_yuzdesi > 100 or indirim_yuzdesi < 0:
    print("Girilen değer matematiksel olarak imkansiz lütfen doğru değer girin.")
    indirim_yuzdesi = int(input("Ürünün indirim yüzdesi: "))
while indirimsiz_tutar < 0:
    print("Girilen değer matematiksel olarak imkansiz lütfen doğru değer girin.")
    indirimsiz_tutar = int(input("Ürünün indirimsiz fiyati: "))
indirim_hesapla(indirimsiz_tutar,indirim_yuzdesi)